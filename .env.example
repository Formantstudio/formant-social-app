# Copy this file to .env and fill in real values.
# .env is gitignored — never commit the real .env file.

# Firebase project: formant-social
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# YouTube Data API v3 key (restricted to this app's bundle ID in Google Cloud Console)
EXPO_PUBLIC_YOUTUBE_API_KEY=
EXPO_PUBLIC_YOUTUBE_CHANNEL_ID=

# AdMob ad unit IDs (not the app IDs — those are in app.json)
EXPO_PUBLIC_ADMOB_BANNER_ANDROID=
EXPO_PUBLIC_ADMOB_BANNER_IOS=
EXPO_PUBLIC_ADMOB_INTERSTITIAL_ANDROID=
EXPO_PUBLIC_ADMOB_INTERSTITIAL_IOS=
